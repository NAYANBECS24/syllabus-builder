# Copy to .env for local development, or set these in the Vercel project
# settings -> Environment Variables. Never commit real keys.

# Server-side fallback used when a request does not carry its own key.
NVIDIA_API_KEY=

# Required to enable Google Books discovery. Create a restricted Google Books
# API key in Google Cloud. The browser never receives this value.
GOOGLE_BOOKS_API_KEY=

# Recommended monitored contact email for Crossref's polite API pool.
CROSSREF_MAILTO=

# Optional: override the location of the system prompt file.
# SYSTEM_PROMPT_PATH=./SYSTEM_PROMPT.md

# Optional multimodal model for unreadable PDF pages in online extraction.
# The NVIDIA default uses the same server-side NVIDIA_API_KEY.
# SYLEX_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
